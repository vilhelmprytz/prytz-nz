# --- Database (Dokploy Postgres service, or docker-compose.dev.yml locally) ---
DATABASE_URL=postgres://postgres:dev@localhost:5433/prytz

# --- Family password gate ---
# Everyone types this once. Changing it signs every reader out.
FAMILY_PASSWORD=change-me
# Number of reverse proxies in front of the app that append to X-Forwarded-For (Traefik = 1).
TRUSTED_PROXY_HOPS=1

# --- Auth (Better Auth + Google) ---
# At least 32 random characters, e.g. `openssl rand -base64 48`.
BETTER_AUTH_SECRET=
# Public URL of the site, e.g. https://prytz.nz (http://localhost:3000 in dev).
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The only Google account that can post.
ADMIN_EMAIL=vilhelm@prytznet.se

# --- Photo storage ---
# s3 = Cloudflare R2 (production). fs = local folder (development only).
STORAGE_DRIVER=s3
# R2 S3 API endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Used only when STORAGE_DRIVER=fs
FS_STORAGE_DIR=.storage

# --- Place names (reverse geocoding). Empty disables it. ---
NOMINATIM_URL=https://nominatim.openstreetmap.org

# --- Email (new-post notifications). Empty SMTP_HOST turns emails off. ---
# Your SMTP server's host name.
SMTP_HOST=
# 587 for STARTTLS (the usual), 465 for TLS from the start.
SMTP_PORT=587
# starttls (TLS required before logging in), tls (TLS from the start, usually port 465), or none (local testing only).
SMTP_SECURITY=starttls
# Login for the SMTP server. Set both or neither.
SMTP_USER=
SMTP_PASSWORD=
# Sender shown in the email. Required when SMTP_HOST is set. Replies go to ADMIN_EMAIL.
SMTP_FROM="prytz.nz <noreply@prytz.nz>"
# Local testing with Mailpit (docker-compose.dev.yml), inbox at http://localhost:8025:
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURITY=none
# SMTP_FROM="prytz.nz <noreply@localhost>"

# --- Test only. Never set in production. ---
# E2E_TEST_AUTH=1
