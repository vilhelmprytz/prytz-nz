# --- Database (Dokploy Postgres service, or docker-compose.dev.yml locally) ---
DATABASE_URL=postgres://postgres:dev@localhost:5433/prytz

# --- Family password gate ---
# Everyone types this once. Changing it signs every reader out.
FAMILY_PASSWORD=change-me
# Number of reverse proxies in front of the app that append to X-Forwarded-For (Traefik = 1).
TRUSTED_PROXY_HOPS=1

# --- Auth (Better Auth + Google) ---
# At least 32 random characters, e.g. `openssl rand -base64 48`.
BETTER_AUTH_SECRET=
# Public URL of the site, e.g. https://prytz.nz (http://localhost:3000 in dev).
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The only Google account that can post.
ADMIN_EMAIL=vilhelm@prytznet.se

# --- Photo storage ---
# s3 = Cloudflare R2 (production). fs = local folder (development only).
STORAGE_DRIVER=s3
# R2 S3 API endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Used only when STORAGE_DRIVER=fs
FS_STORAGE_DIR=.storage

# --- Place names (reverse geocoding). Empty disables it. ---
NOMINATIM_URL=https://nominatim.openstreetmap.org

# --- Test only. Never set in production. ---
# E2E_TEST_AUTH=1
